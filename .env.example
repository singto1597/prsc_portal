# ==========================================
# ⚙️ SYSTEM SETTINGS
# ==========================================
ENV_NAME=staging_or_production
API_DOMAIN=api.yourdomain.com
WEB_DOMAIN=app.yourdomain.com

# ==========================================
# 🐘 BACKEND (PostgreSQL & Security)
# ==========================================
# รูปแบบ: postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DB_NAME]
DATABASE_URL=postgresql://db_user:db_password@staging_infra_db:5432/prsc_db

POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=prsc_db

# สุ่มตัวอักษรเพื่อใช้เป็น Key ของระบบ
API_KEY=your_random_api_key_here
SECRET_KEY=your_random_secret_key_here
SUPER_ADMIN_ID=1234567890

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

REDIS_URL=redis://${ENV_NAME}_infra_redis:6379/0

# ==========================================
# 🌐 FRONTEND (Vue / Vite)
# ==========================================
VITE_API_BASE_URL=https://api.yourdomain.com
