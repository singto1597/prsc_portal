# ==========================================
# ⚙️ SYSTEM SETTINGS
# ==========================================
ENV_NAME=staging_or_production
API_DOMAIN=api.yourdomain.com
WEB_DOMAIN=app.yourdomain.com

# ==========================================
# 🐘 BACKEND (PostgreSQL & Security)
# ==========================================
# รูปแบบ: postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DB_NAME]
# ⚠️ host ต้องเป็น ${ENV_NAME}_infra_db เสมอ (ชื่อ service ของ Postgres ใน Swarm)
#    ใน Docker Compose ค่า DATABASE_URL/REDIS_URL ถูก override อัตโนมัติจาก ENV_NAME
#    → แก้แค่ ENV_NAME ด้านบน ระบบชี้ host ตัวใหม่ให้เอง (ค่าในนี้เป็นแค่ fallback/เอกสาร)
#    ถ้ารัน dev ในเครื่อง (ไม่ใช้ Docker) ให้เปลี่ยนเป็น localhost:5432/<db> เอาเอง
DATABASE_URL=postgresql://db_user:db_password@${ENV_NAME}_infra_db:5432/piri_db

POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=piri_db

# สุ่มตัวอักษรเพื่อใช้เป็น Key ของระบบ
API_KEY=your_random_api_key_here
SECRET_KEY=your_random_secret_key_here
SUPER_ADMIN_ID=1234567890

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# ใน Docker Compose ค่านี้ถูก override จาก ENV_NAME เช่นกัน (ดู comment DATABASE_URL ข้างบน)
REDIS_URL=redis://${ENV_NAME}_infra_redis:6379/0

# อีเมลสำหรับแจ้ง certificate Let's Encrypt — ใช้เมื่อเปิด HTTPS ใน docker-compose.proxy.yml
# ACME_EMAIL=admin@yourdomain.com

# Queue Import นักเรียนจาก Excel (ARQ Worker)
# โฟลเดอร์เก็บไฟล์ .xlsx — Docker ใช้ /data/imports (shared volume ระหว่าง backend+worker)
# ถ้ารัน dev ในเครื่อง ใส่เช่น IMPORT_STORAGE_DIR=./backend/data/imports
IMPORT_STORAGE_DIR=/data/imports
IMPORT_FILE_SIZE_LIMIT_MB=10
# แถวสูงสุดต่อไฟล์ (กันไฟล์ยักษ์) + จำนวนแถวต่อ batch + อายุงานค้างที่นาทีที่ worker จะกู้คืน
IMPORT_MAX_ROWS=5000
IMPORT_BATCH_SIZE=50
IMPORT_RECOVERY_STALE_MINUTES=35

# Seed users (admin/ครูสภา/ประธานสภา) ตอนเปิดระบบครั้งแรก
# ไฟล์ที่ระบบจะเขียน username + รหัสผ่านชั่วคราวให้ (gitignored) — ควรเปลี่ยนเป็น path ที่ปลอดภัย
SEED_CREDENTIALS_FILE=./default_admin_credentials.txt

# ==========================================
# 🌐 FRONTEND (Vue / Vite)
# ==========================================
VITE_API_BASE_URL=https://api.yourdomain.com
